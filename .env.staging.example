# ==============================================================================
# Dedicated Disposable Staging Environment Template for Integration Tests
# ==============================================================================
# DO NOT put production credentials here!
# This environment is used exclusively for destructive/ephemeral integration tests.

# Dedicated disposable staging Supabase URL (format: https://<20-char-ref>.supabase.co)
STAGING_SUPABASE_URL="https://abcdefghijklmnopqrst.supabase.co"

# Dedicated disposable staging Supabase service-role key
STAGING_SERVICE_ROLE_KEY="your-staging-service-role-key"

# Dedicated disposable staging Supabase anon key (low-privilege API key for RLS testing)
STAGING_ANON_KEY="your-staging-anon-key"

# Expected 20-character project reference matching the hostname of STAGING_SUPABASE_URL
EXPECTED_STAGING_PROJECT_REF="abcdefghijklmnopqrst"

# Explicit confirmation that this target database is disposable and can be mutated/cleaned
CONFIRM_DISPOSABLE_DATABASE="true"
