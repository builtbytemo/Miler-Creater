# ==============================================================================
# Content & Task Command Center - Environment Variable Template
# ==============================================================================
# DO NOT commit real secrets or .env.local to version control.
# Copy this file to .env.local and fill in your actual Supabase project keys.

# ------------------------------------------------------------------------------
# Supabase Configuration (Public / Browser Safe)
# ------------------------------------------------------------------------------
# Your Supabase Project REST URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Your Supabase Anon Key (found in Project Settings -> API)
# This key is safe to be exposed in browser client code because all operations
# are strictly protected and bounded by Row Level Security (RLS) policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Canonical URL of the application (used for OAuth redirects, email confirmation, etc.)
# Local development default:
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Supabase Configuration (SERVER ONLY - STRICTLY CONFIDENTIAL)
# ------------------------------------------------------------------------------
# Your Supabase Service Role Key (found in Project Settings -> API)
# WARNING: NEVER prefix with NEXT_PUBLIC_!
# WARNING: NEVER import or use this key in client-side React components!
# This key bypasses Row Level Security and is reserved exclusively for background
# workers, seed scripts, and trusted server-side administrative endpoints.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# ------------------------------------------------------------------------------
# Scheduled Job / Cron Configuration (SERVER ONLY - STRICTLY CONFIDENTIAL)
# ------------------------------------------------------------------------------
# Secret token used to authenticate incoming calls to /api/cron/reminders
# Pass as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="your-secure-random-cron-secret-token"

# ------------------------------------------------------------------------------
# Daily Briefing Delivery (SERVER ONLY). All optional; delivery is OFF by default.
# ------------------------------------------------------------------------------
# Production kill switch for /api/cron/daily-briefing. Must be exactly "true" to run.
DAILY_BRIEFING_DELIVERY_ENABLED=false
# Telegram bot (from @BotFather). Token never reaches the client.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random string you choose; registered as setWebhook secret_token.
TELEGRAM_WEBHOOK_SECRET=
# Email via Resend (https://resend.com). EMAIL_FROM must be on a verified sending domain.
RESEND_API_KEY=
EMAIL_FROM=
