# ==============================================================================
# Content & Task Command Center - Environment Variable Template
# ==============================================================================
# DO NOT commit real secrets or .env.local to version control.
# Copy this file to .env.local and fill in your actual Supabase project keys.

# ------------------------------------------------------------------------------
# Supabase Configuration (Public / Browser Safe)
# ------------------------------------------------------------------------------
# Your Supabase Project REST URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Your Supabase Anon Key (found in Project Settings -> API)
# This key is safe to be exposed in browser client code because all operations
# are strictly protected and bounded by Row Level Security (RLS) policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Canonical URL of the application (used for OAuth redirects, email confirmation, etc.)
# Local development default:
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Supabase Configuration (SERVER ONLY - STRICTLY CONFIDENTIAL)
# ------------------------------------------------------------------------------
# Your Supabase Service Role Key (found in Project Settings -> API)
# WARNING: NEVER prefix with NEXT_PUBLIC_!
# WARNING: NEVER import or use this key in client-side React components!
# This key bypasses Row Level Security and is reserved exclusively for background
# workers, seed scripts, and trusted server-side administrative endpoints.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# ------------------------------------------------------------------------------
# Scheduled Job / Cron Configuration (SERVER ONLY - STRICTLY CONFIDENTIAL)
# ------------------------------------------------------------------------------
# Secret token used to authenticate incoming calls to /api/cron/reminders
# Pass as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="your-secure-random-cron-secret-token"

# ------------------------------------------------------------------------------
# Daily Briefing Delivery (SERVER ONLY). All optional; delivery is OFF by default.
# ------------------------------------------------------------------------------
# Kill switch for /api/cron/daily-briefing. Must be exactly "true" to run.
DAILY_BRIEFING_DELIVERY_ENABLED=false
# Self-hosted / non-Vercel / custom-project cron target guard:
# Set to your Supabase hostname (e.g. your-project-ref.supabase.co) so /api/cron/daily-briefing
# verifies NEXT_PUBLIC_SUPABASE_URL matches your intended database before running.
DAILY_BRIEFING_EXPECTED_SUPABASE_HOST=
# Telegram bot (from @BotFather). Token never reaches the client.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random string you choose; registered as setWebhook secret_token.
TELEGRAM_WEBHOOK_SECRET=
# Email via Resend (https://resend.com).
# Personal Email Mode defaults to fail-closed single-user delivery across all environments.
# - onboarding@resend.dev (e.g. "Zahi <onboarding@resend.dev>") is Resend's testing sender and
#   can ONLY deliver to recipients permitted by your own Resend account (typically the Resend
#   account owner's verified email; Resend rejects other recipients with HTTP 403).
# - For multi-recipient or production external delivery, configure a sender on your own
#   verified sending domain. onboarding@resend.dev does NOT support public SaaS email.
RESEND_API_KEY=
EMAIL_FROM=
# Required Personal Email Mode allowlist (fail-closed if either is missing or invalid):
# - UUID of the single authorized Supabase Auth user (auth.users.id)
DAILY_BRIEFING_EMAIL_ALLOWED_USER_ID=
# - Verified login email address for that authorized user (case-insensitive)
DAILY_BRIEFING_EMAIL_ALLOWED_RECIPIENT=
